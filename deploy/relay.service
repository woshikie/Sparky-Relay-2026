[Unit]
Description=Relay — Telegram step bot for Olympics 2026
Documentation=file:/opt/sparky-relay-2026/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/sparky-relay-2026
ExecStart=/opt/sparky-relay-2026/bot.sh

# The browser is launched per Screenshot and needs ~780MB while it runs.
# A 1GB host cannot hold two of these, and a runaway loop would exhaust memory
# by respawning. These limits make the bot the thing that gets restarted
# rather than the kernel OOM killer picking a victim.
MemoryMax=900M
MemoryHigh=820M
MemorySwapMax=0
TasksMax=256

# Do not thrash when the host is out of memory: wait for it to come back.
Restart=always
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=5

# Modest CPU allowance: the OCR is single-threaded WASM, it does not need a core
# to itself, and leaving headroom keeps the bot responsive to Telegram.
CPUQuota=150%
Nice=10

# Hardening. The bot reads its own directory and talks to two hosts.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sparky-relay-2026
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Small, quiet logs. The bot narrates to Telegram, so stdout is diagnostics.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=relay

[Install]
WantedBy=multi-user.target
