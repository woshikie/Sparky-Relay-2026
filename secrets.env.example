# Required from @BotFather
TELEGRAM_BOT_TOKEN=

# MANDATORY. Decides who may drive the Relay. The bot exits rather than guess.
#
#   whitelist_claim  only the first chat to /start gets access. Safest.
#   blacklist       anyone not on DENY_CHAT_IDS can drive it. PUBLIC write path
#                   into whatever Site account those chats supply.
#   shared_secret   each person sends their own secret at /start.
ACCESS_MODE=whitelist_claim

# Optional Preset Credentials. If set, the bot offers them at the prompt and
# shows the username so you can confirm the account. Leave them out and the bot
# simply asks you for a username and password instead. Either way works.
SITE_USERNAME=
SITE_PASSWORD=

SITE_BASE=https://example.invalid

# blacklist mode only. Comma or semicolon separated chat ids.
# DENY_CHAT_IDS=

# shared_secret mode only. One "label:secret" per line; only hashes are stored.
# SHARED_SECRETS=alice:some-long-passphrase
# SHARED_SECRETS=bob:another-long-passphrase

# 1 = headless (normal for a server). Set 0 to watch it work locally.
HEADLESS=1

# Only needed if Firefox is not at /usr/bin/firefox
# FIREFOX_BIN=/usr/bin/firefox

# Local courtesy warning only. The site is the authority on its own cutoff.
# KNOWN_CUTOFF=2026-11-02T15:59:00+00:00

# When the nightly ledger backup is sent to you (SGT).
BACKUP_TIME=03:17
