# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Credentials for the Olympics 2026 site.
# The site signs in as <SITE_USERNAME>@olympics.local — that mapping is the
# site's own, not ours.
SITE_USERNAME=
SITE_PASSWORD=
SITE_BASE=https://example.invalid

# Authorise exactly one Telegram chat. Leave empty to let the first chat that
# messages the bot become the authorised one, then pin it here.
ALLOWED_CHAT_ID=

# 1 = headless (normal for a server). Set 0 to watch it work locally.
HEADLESS=1

# Only needed if Firefox is not at /usr/bin/firefox
# FIREFOX_BIN=/usr/bin/firefox

# Local courtesy warning only. The site is the authority on its own cutoff.
# KNOWN_CUTOFF=2026-11-02T15:59:00+00:00

# When the nightly ledger backup is sent to you (SGT).
BACKUP_TIME=03:17
